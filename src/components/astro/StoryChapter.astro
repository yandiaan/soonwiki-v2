---
interface Props {
  label: string;
  story: string;
  frameNumber?: string;
  variant?: 'default' | 'pullquote';
}

const { label, story, frameNumber, variant = 'default' } = Astro.props;
---

<article class={`story-chapter story-chapter--${variant}`} data-story-chapter>
  {frameNumber && <p class="frame-number">{frameNumber}</p>}
  <p class="label">{label}</p>
  {
    variant === 'pullquote' ? (
      <blockquote class="story-chapter__quote">
        <span class="story-chapter__mark" aria-hidden="true">
          “
        </span>
        {story}
      </blockquote>
    ) : (
      <p class="story">{story}</p>
    )
  }
</article>

<style>
  .story-chapter {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.25rem;
    border-top: 2px solid var(--ink);
  }

  .story-chapter--pullquote {
    padding-block: 2rem;
  }

  .frame-number {
    margin: 0;
    color: var(--cobalt);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .label {
    margin: 0;
    color: var(--signal);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .story {
    margin: 0;
    max-width: 60ch;
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .story-chapter__quote {
    max-width: 44rem;
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .story-chapter__mark {
    display: block;
    margin-block-end: -0.35em;
    color: var(--signal);
    font-size: clamp(3rem, 8vw, 5rem);
    line-height: 1;
  }
</style>
