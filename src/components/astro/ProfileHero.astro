---
import MetadataStrip from '@/components/astro/MetadataStrip.astro';
import PortraitFrame from '@/components/astro/PortraitFrame.astro';

import type { ProfileDetail } from '@/lib/shared/public-models';

interface Props {
  profile: ProfileDetail;
}

const { profile } = Astro.props;

const metadata = [
  `Soon ${profile.batchYear}`,
  profile.currentActivity,
  profile.currentPlaceName,
].filter((item): item is string => Boolean(item));
---

<header class="profile-hero">
  <div class="profile-hero__media">
    <PortraitFrame
      photoPath={profile.photoPath}
      name={profile.name}
      loading="eager"
      transitionKey={`profile-${profile.id}`}
    />
  </div>
  <div class="profile-hero__body">
    <h1>{profile.name}</h1>
    <MetadataStrip items={metadata} />
    {profile.bio && <p class="profile-hero__bio">{profile.bio}</p>}
  </div>
</header>

<style>
  .profile-hero {
    display: grid;
    gap: 2rem;
    padding-block: 2rem 3rem;
  }

  .profile-hero__media {
    max-width: 18rem;
    border-radius: 1rem;
    overflow: hidden;
  }

  .profile-hero__body {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .profile-hero__body h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 650;
    line-height: 0.96;
    letter-spacing: -0.035em;
  }

  .profile-hero__bio {
    max-width: 48ch;
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.15rem;
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .profile-hero {
      grid-template-columns: 16rem 1fr;
      align-items: start;
      gap: 3rem;
    }
  }
</style>
