---
import PortraitFrame from '@/components/astro/PortraitFrame.astro';
import { paths } from '@/lib/shared/paths';

import type { HomeStory } from '@/lib/shared/public-models';

interface Props {
  story: HomeStory;
}

const { story } = Astro.props;
const profiles = [story.featured, ...story.contactSheet].slice(0, 4);
const firstBatch = profiles[0]?.batchYear;
const firstPlace = profiles.find((profile) => profile.currentPlaceSlug);
---

<section class="explore-pathways" aria-labelledby="explore-pathways-title">
  <div class="explore-pathways__content" data-reveal>
    <h2 id="explore-pathways-title">Cari seseorang. Temukan lebih banyak jalan.</h2>
    <p>Semua kisah dapat dibaca tanpa akun.</p>
    <form method="get" action={paths.explore()} role="search">
      <label for="home-search">Cari SoonMates</label>
      <div>
        <input
          id="home-search"
          type="search"
          name="q"
          placeholder="Cari nama, bidang, generasi, atau tempat"
        />
        <button type="submit">Cari</button>
      </div>
    </form>
    <nav class="explore-pathways__routes" aria-label="Cara menjelajahi SoonWiki">
      <a href={paths.explore()}>Lewat bidang</a>
      <a href={firstBatch ? paths.batch(firstBatch) : paths.explore()}>Lewat generasi</a>
      <a
        href={firstPlace?.currentPlaceSlug
          ? paths.place(firstPlace.currentPlaceSlug)
          : paths.explore()}
      >
        Lewat tempat
      </a>
    </nav>
    <a class="explore-pathways__all" href={paths.explore()}>
      <span>Jelajahi semua</span>
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M12 5l7 7-7 7"></path>
      </svg>
    </a>
    <p class="explore-pathways__member">
      Punya cerita untuk dibagikan? <a href={paths.login()}>Masuk sebagai member</a>
    </p>
  </div>
  <ul class="explore-pathways__people" aria-label="Beberapa SoonMates" data-reveal-group>
    {
      profiles.map((profile) => (
        <li>
          <a href={paths.profile(profile.slug)}>
            <PortraitFrame photoPath={profile.photoPath} name={profile.name} />
            <strong>{profile.name}</strong>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .explore-pathways {
    padding: clamp(4.5rem, 9vw, 8rem) var(--page-gutter) 0;
    background: var(--surface-muted);
    border-top: 1px solid var(--line-soft);
  }

  .explore-pathways__content {
    display: grid;
    justify-items: center;
    max-width: 70rem;
    margin-inline: auto;
    text-align: center;
  }

  h2 {
    max-width: 17ch;
    margin: 0;
    font-size: clamp(2.6rem, 5.5vw, 5.6rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .explore-pathways__content > p:first-of-type {
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
  }

  form {
    width: min(100%, 58rem);
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  form > label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  form > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
  }

  input,
  button {
    min-height: 4.25rem;
    border-radius: 0.75rem;
    font: inherit;
  }

  input {
    min-width: 0;
    padding-inline: 1.25rem;
    border: 1px solid var(--line-soft);
    background: var(--surface);
    color: var(--ink);
    font-size: 1.05rem;
    transition:
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  button {
    padding-inline: 1.75rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--surface);
    font-weight: 750;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      transform 200ms var(--ease-out),
      box-shadow 200ms ease;
  }

  button:hover {
    background: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -4px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .explore-pathways__routes {
    display: grid;
    width: min(100%, 58rem);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .explore-pathways__routes a {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.25rem;
    border-radius: 9999px;
    border: 1px solid var(--line-soft);
    background: var(--surface);
    color: var(--ink);
    font-size: clamp(0.95rem, 1.8vw, 1.15rem);
    font-weight: 700;
    text-decoration: none;
    transition:
      border-color 200ms ease,
      color 200ms ease,
      transform 200ms var(--ease-out),
      box-shadow 200ms ease;
  }

  .explore-pathways__routes a:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px -4px rgb(0 0 0 / 0.08);
  }

  .explore-pathways__all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    margin-top: 1.75rem;
    color: var(--accent);
    font-weight: 750;
    text-decoration: none;
    transition:
      color 200ms ease,
      transform 200ms var(--ease-out);
  }

  .explore-pathways__all:hover {
    color: var(--accent-strong);
    transform: translateX(4px);
  }

  .explore-pathways__member {
    margin: 1rem 0 3.5rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .explore-pathways__member a {
    color: var(--accent);
    font-weight: 700;
    text-underline-offset: 3px;
  }

  .explore-pathways__people {
    display: grid;
    max-width: var(--content-max);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .explore-pathways__people a {
    position: relative;
    display: block;
    color: var(--surface);
  }

  .explore-pathways__people :global(.portrait-frame) {
    height: clamp(12rem, 24vw, 24rem);
    border: 0;
    border-radius: 0.75rem 0.75rem 0 0;
    aspect-ratio: auto;
  }

  .explore-pathways__people strong {
    position: absolute;
    inset-inline: 1rem;
    bottom: 1rem;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.65);
  }

  @media (max-width: 700px) {
    form > div {
      grid-template-columns: 1fr;
    }

    .explore-pathways__routes {
      grid-template-columns: 1fr;
    }

    .explore-pathways__people {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
