---
import ProfileCard from '@/components/astro/ProfileCard.astro';

import type { ProfileCard as ProfileCardModel } from '@/lib/shared/public-models';

interface Props {
  profiles: ProfileCardModel[];
}

const { profiles } = Astro.props;
---

<section class="related-journeys" aria-labelledby="related-journeys-title">
  <p class="frame-number">PERJALANAN LAIN</p>
  <h2 id="related-journeys-title">Perjalanan lain yang mungkin menarik</h2>
  <ul class="related-journeys__grid">
    {
      profiles.map((profile) => (
        <li>
          <ProfileCard profile={profile} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .related-journeys {
    display: grid;
    gap: 0.75rem;
    padding-block: 1.5rem 3rem;
    border-top: 2px solid var(--ink);
  }

  .frame-number {
    margin: 0;
    color: var(--cobalt);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.25rem, 4vw, 1.75rem);
  }

  .related-journeys__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
