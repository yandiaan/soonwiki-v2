---
import { navigationLinks, paths } from '@/lib/shared/paths';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="site-header">
  <a class="brand" href={paths.home()}>SoonWiki</a>
  <nav aria-label="Navigasi utama" class="desktop-nav">
    <ul>
      {
        navigationLinks.map((link) => (
          <li>
            <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 40;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
    padding: 0.75rem var(--page-gutter);
    border-bottom: 1px solid var(--line-soft);
    background: color-mix(in srgb, var(--canvas) 92%, transparent);
    backdrop-filter: blur(14px);
  }

  .brand {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .desktop-nav ul {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    text-decoration: none;
  }

  .desktop-nav a[aria-current='page'] {
    color: var(--accent);
  }

  .desktop-nav a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  @media (max-width: 640px) {
    .desktop-nav {
      display: none;
    }
  }
</style>
