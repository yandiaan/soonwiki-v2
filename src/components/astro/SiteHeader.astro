---
import { paths } from '@/lib/shared/paths';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navItems = [
  { href: paths.home(), label: 'Beranda' },
  { href: paths.explore(), label: 'Jelajahi' },
  { href: paths.about(), label: 'Tentang' },
];
---

<header class="site-header" id="site-header">
  <div class="site-header__container">
    <!-- Brand / Monogram -->
    <a class="brand" href={paths.home()} aria-label="SoonWiki Beranda">
      <span class="brand__icon">
        <span class="brand__dot"></span>
      </span>
      <span class="brand__text">
        <strong>SOON</strong><span class="brand__sub">WIKI</span>
      </span>
    </a>

    <!-- Center Navigation Links with Sliding Active Pill -->
    <nav aria-label="Navigasi utama" class="desktop-nav">
      <ul class="nav-pill-list" id="nav-pill-list">
        <!-- Floating Sliding Background Indicator Pill -->
        <li class="nav-indicator" id="nav-indicator" aria-hidden="true"></li>

        {
          navItems.map((link) => {
            const isActive =
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
            return (
              <li class="nav-item">
                <a
                  href={link.href}
                  class:list={['nav-link', { 'is-active': isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                  data-nav-item
                >
                  <span>{link.label}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Right Controls: Auth CTA -->
    <div class="site-header__actions">
      <a
        href={paths.login()}
        class:list={['login-btn', { 'is-active': currentPath === paths.login() }]}
        aria-label="Masuk ke Ruang Soonies"
      >
        <span>Masuk</span>
      </a>
    </div>
  </div>
</header>

<script>
  import { getLenis } from '@/lib/browser/smooth-scroll';

  function setupHeader() {
    const header = document.getElementById('site-header');
    const list = document.getElementById('nav-pill-list');
    const indicator = document.getElementById('nav-indicator');

    // 1. Hardware-Accelerated Scroll State Sync
    function updateScrolledState(scrollY: number) {
      if (scrollY > 15) {
        header?.setAttribute('data-scrolled', 'true');
      } else {
        header?.removeAttribute('data-scrolled');
      }
    }

    const lenis = getLenis();
    if (lenis) {
      lenis.on('scroll', ({ scroll }: { scroll: number }) => {
        updateScrolledState(scroll);
      });
    }

    window.addEventListener(
      'scroll',
      () => {
        updateScrolledState(window.scrollY);
      },
      { passive: true },
    );
    updateScrolledState(window.scrollY);

    // 2. Sliding Active Pill Motion Engine
    if (!list || !indicator) return;

    function moveIndicatorTo(targetEl: HTMLElement | null, animate = true) {
      if (!targetEl || !indicator || !list) return;
      const listRect = list.getBoundingClientRect();
      const targetRect = targetEl.getBoundingClientRect();

      const left = targetRect.left - listRect.left;
      const width = targetRect.width;

      if (!animate) {
        indicator.style.transition = 'none';
      } else {
        indicator.style.transition =
          'transform 350ms cubic-bezier(0.19, 1, 0.22, 1), width 350ms cubic-bezier(0.19, 1, 0.22, 1), opacity 200ms ease';
      }

      indicator.style.opacity = '1';
      indicator.style.transform = `translate3d(${left}px, 0, 0)`;
      indicator.style.width = `${width}px`;
    }

    const activeLink =
      list.querySelector<HTMLElement>('.nav-link.is-active') ||
      list.querySelector<HTMLElement>('.nav-link');

    // Initial position without jump
    moveIndicatorTo(activeLink, false);
    setTimeout(() => {
      moveIndicatorTo(activeLink, true);
    }, 50);

    // Hover & focus gliding
    const links = list.querySelectorAll<HTMLElement>('[data-nav-item]');
    links.forEach((link) => {
      link.addEventListener('mouseenter', () => {
        moveIndicatorTo(link, true);
      });
      link.addEventListener('focus', () => {
        moveIndicatorTo(link, true);
      });
    });

    list.addEventListener('mouseleave', () => {
      moveIndicatorTo(activeLink, true);
    });
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    justify-content: center;
    width: 100%;
    padding: 0.85rem var(--page-gutter);
    pointer-events: none;
    transition: padding 350ms cubic-bezier(0.19, 1, 0.22, 1);
  }

  .site-header__container {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    max-width: min(100%, 58rem);
    min-height: 3.5rem;
    padding: 0.4rem 0.75rem 0.4rem 1.25rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--canvas) 85%, transparent);
    backdrop-filter: blur(20px) saturate(1.5);
    -webkit-backdrop-filter: blur(20px) saturate(1.5);
    border: 1px solid color-mix(in srgb, var(--line-soft) 80%, transparent);
    box-shadow: 0 4px 20px -4px rgb(0 0 0 / 0.04);
    will-change: transform, backdrop-filter, box-shadow;
    transition:
      background-color 300ms ease,
      border-color 300ms ease,
      box-shadow 350ms cubic-bezier(0.19, 1, 0.22, 1),
      backdrop-filter 300ms ease,
      transform 350ms cubic-bezier(0.19, 1, 0.22, 1);
  }

  /* Scrolled State: GPU-Accelerated Elevation (Zero Layout Reflow) */
  .site-header[data-scrolled='true'] {
    padding-top: 0.65rem;
  }

  .site-header[data-scrolled='true'] .site-header__container {
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(28px) saturate(1.6);
    -webkit-backdrop-filter: blur(28px) saturate(1.6);
    border-color: color-mix(in srgb, var(--ink) 12%, transparent);
    box-shadow:
      0 16px 36px -8px rgb(0 0 0 / 0.09),
      0 1px 3px 0 rgb(0 0 0 / 0.04);
    transform: translate3d(0, -1px, 0);
  }

  /* Brand Styling */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
    transition: transform 200ms cubic-bezier(0.19, 1, 0.22, 1);
  }

  .brand:hover {
    transform: scale(1.02);
  }

  .brand__icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--ink);
  }

  .brand__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: brand-pulse 3s ease-in-out infinite alternate;
  }

  @keyframes brand-pulse {
    0% {
      opacity: 0.75;
      transform: scale(0.9);
    }
    100% {
      opacity: 1;
      transform: scale(1.15);
    }
  }

  .brand__text {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .brand__sub {
    font-weight: 400;
    color: var(--ink-soft);
    margin-left: 1px;
  }

  /* Desktop Navigation Pills */
  .desktop-nav {
    position: relative;
  }

  .nav-pill-list {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0.25rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--ink) 4%, transparent);
    list-style: none;
  }

  .nav-item {
    position: relative;
    z-index: 2;
  }

  /* Floating Active Indicator Pill */
  .nav-indicator {
    position: absolute;
    top: 0.25rem;
    bottom: 0.25rem;
    left: 0;
    z-index: 1;
    border-radius: 9999px;
    background: var(--surface);
    box-shadow:
      0 2px 8px -1px rgb(0 0 0 / 0.08),
      0 1px 2px 0 rgb(0 0 0 / 0.04);
    opacity: 0;
    pointer-events: none;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 0.35rem 1.15rem;
    border-radius: 9999px;
    color: var(--ink-soft);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--ink);
  }

  /* Right Actions */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Login Button */
  .login-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0.4rem 1.25rem;
    border-radius: 9999px;
    background: var(--ink);
    color: var(--surface);
    font-size: 0.86rem;
    font-weight: 750;
    text-decoration: none;
    transition:
      transform 200ms cubic-bezier(0.19, 1, 0.22, 1),
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  .login-btn:hover {
    background: color-mix(in srgb, var(--ink) 85%, var(--accent));
    transform: translateY(-1px);
    box-shadow: 0 6px 18px -4px rgb(0 0 0 / 0.16);
  }

  .login-btn.is-active {
    background: var(--accent);
  }

  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }
  }
</style>
