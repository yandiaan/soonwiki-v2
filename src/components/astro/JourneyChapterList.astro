---
import JourneyTimeline from '@/components/svelte/JourneyTimeline.svelte';

import type { JourneyChapter } from '@/lib/shared/public-models';

interface Props {
  journeys: JourneyChapter[];
}

const { journeys } = Astro.props;

function formatPeriod(entry: JourneyChapter): string {
  if (entry.startYear && entry.endYear) {
    return `${entry.startYear} – ${entry.endYear}`;
  }

  if (entry.startYear) {
    return `${entry.startYear} – Sekarang`;
  }

  return '';
}
---

<section class="journey-section" aria-labelledby="journey-section-title" data-reveal>
  <header class="journey-section__header">
    <div class="journey-badge">
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span>Linimasa Karier & Jejak Langkah</span>
    </div>
    <h2 id="journey-section-title">Rekam Perjalanan</h2>
  </header>

  <JourneyTimeline client:visible>
    <ol class="journey-timeline__list">
      {
        journeys.map((entry, index) => (
          <li class="journey-node" data-journey-entry>
            <div class="journey-node__indicator" aria-hidden="true">
              <span class="journey-node__dot" />
              {index < journeys.length - 1 && <span class="journey-node__line" />}
            </div>

            <div class="journey-node__card">
              {formatPeriod(entry) && (
                <span class="journey-node__period">{formatPeriod(entry)}</span>
              )}
              <h3 class="journey-node__activity">{entry.activity}</h3>
              {entry.placeName && (
                <div class="journey-node__place">
                  <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M3 21h18" />
                    <path d="M9 8h1" />
                    <path d="M9 12h1" />
                    <path d="M9 16h1" />
                    <path d="M14 8h1" />
                    <path d="M14 12h1" />
                    <path d="M14 16h1" />
                    <path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16" />
                  </svg>
                  <span>{entry.placeName}</span>
                </div>
              )}
              {entry.story && <p class="journey-node__story">{entry.story}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </JourneyTimeline>
</section>

<style>
  .journey-section {
    display: grid;
    gap: 1.75rem;
    padding-block: 2.5rem;
    margin-block: 1rem;
  }

  .journey-section__header {
    display: grid;
    gap: 0.4rem;
  }

  .journey-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .journey-timeline__list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journey-node {
    position: relative;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1.25rem;
    padding-bottom: 2rem;
  }

  .journey-node:last-child {
    padding-bottom: 0;
  }

  .journey-node__indicator {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .journey-node__dot {
    position: relative;
    z-index: 2;
    width: 14px;
    height: 14px;
    margin-top: 0.35rem;
    border-radius: 50%;
    background: var(--surface);
    border: 3px solid var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 15%, transparent);
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  .journey-node__line {
    position: absolute;
    top: 1.2rem;
    bottom: -0.5rem;
    width: 2px;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--accent) 40%, var(--line-soft)),
      var(--line-soft)
    );
    z-index: 1;
  }

  .journey-node__card {
    display: grid;
    gap: 0.45rem;
    padding: 1.25rem 1.5rem;
    border-radius: 1rem;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    box-shadow:
      0 6px 20px -6px rgba(18, 21, 20, 0.04),
      0 2px 4px -2px rgba(18, 21, 20, 0.02);
    transition:
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .journey-node:hover .journey-node__card {
    transform: translateX(4px);
    border-color: var(--accent);
    box-shadow:
      0 12px 28px -8px rgba(18, 21, 20, 0.08),
      0 4px 8px -2px rgba(18, 21, 20, 0.03);
  }

  .journey-node:hover .journey-node__dot {
    transform: scale(1.25);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .journey-node__period {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.15rem 0.6rem;
    border-radius: 9999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.03em;
  }

  .journey-node__activity {
    margin: 0.15rem 0 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.35;
  }

  .journey-node__place {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-soft);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .journey-node__story {
    margin: 0.35rem 0 0;
    color: var(--ink);
    font-size: 1.02rem;
    line-height: 1.65;
    max-width: 54ch;
  }
</style>
