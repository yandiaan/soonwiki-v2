---
import { publicStorageUrl } from '@/lib/shared/paths';
import { viewTransitionStyle } from '@/lib/browser/view-transitions';

interface Props {
  photoPath?: string | null;
  name: string;
  frameNumber?: string;
  caption?: string;
  loading?: 'eager' | 'lazy';
  transitionKey?: string;
}

const { photoPath, name, frameNumber, caption, loading = 'lazy', transitionKey } = Astro.props;

const initials = name
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase())
  .join('');

const photoUrl = photoPath ? publicStorageUrl('profile-photos', photoPath) : null;
---

<figure
  class="portrait-frame"
  data-profile-transition-key={transitionKey}
  style={viewTransitionStyle(transitionKey)}
>
  {
    photoUrl ? (
      <img src={photoUrl} alt={name} loading={loading} decoding="async" />
    ) : (
      <span class="initials" aria-hidden="true">
        {initials}
      </span>
    )
  }
  {frameNumber && <span class="frame-number">{frameNumber}</span>}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .portrait-frame {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 0.75rem;
    background: var(--surface-muted);
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .initials {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 750;
    color: var(--ink-soft);
    background: var(--surface-muted);
  }

  .frame-number {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.2rem 0.5rem;
    border-radius: 0.375rem;
    background: color-mix(in srgb, var(--ink) 80%, transparent);
    backdrop-filter: blur(8px);
    color: var(--surface);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.04em;
  }

  figcaption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 0.6rem 0.75rem;
    background: linear-gradient(0deg, rgb(10 12 11 / 0.82) 0%, transparent 100%);
    color: var(--surface);
    font-size: 0.75rem;
    font-weight: 600;
  }
</style>
