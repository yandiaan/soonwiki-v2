---
import { getGenerationName } from '@/lib/shared/generations';
import type { MemoryCard } from '@/lib/shared/memory-models';
import { mediaStreamUrl, paths, publicStorageUrl } from '@/lib/shared/paths';

interface Props {
  memories: MemoryCard[];
}

const { memories } = Astro.props;
const displayMemories = memories.slice(0, 4);
---

{
  displayMemories.length > 0 && (
    <section class="featured-memories" aria-labelledby="featured-memories-title" data-reveal>
      <div class="featured-memories__header">
        <div class="featured-memories__heading">
          <p class="featured-memories__tag">Galeri Kenangan</p>
          <h2 id="featured-memories-title">Momen yang terpatri dalam perjalanan bersama.</h2>
          <p class="featured-memories__intro">
            Arsip foto dan rekaman video kenangan yang diabadikan oleh SoonMates lintas generasi.
          </p>
        </div>
        <a href={paths.memories()} class="featured-memories__link">
          Jelajahi galeri kenangan →
        </a>
      </div>

      <div class="featured-memories__grid" data-reveal-group>
        {displayMemories.map((memory) => {
          const mediaUrl =
            memory.mediaType === 'video'
              ? mediaStreamUrl('memories', memory.mediaPath)
              : publicStorageUrl('memories', memory.mediaPath);
          const authorPhoto = memory.author?.photoPath
            ? publicStorageUrl('profile-photos', memory.author.photoPath)
            : null;
          const authorName = memory.author?.name || 'SoonMate';
          const genName = getGenerationName(memory.generationKey);

          return (
            <article class="featured-memory-card">
              <a
                href={`/memories/${memory.id}`}
                class="featured-memory-card__media-link"
                aria-label={`Lihat kenangan: ${memory.title}`}
                onmouseenter="this.querySelector('video')?.play().catch(() => {})"
                onmouseleave="const v = this.querySelector('video'); if (v) { v.pause(); v.currentTime = 0; }"
              >
                <div
                  class="featured-memory-card__media-wrap"
                  style={`aspect-ratio: ${memory.mediaAspectRatio || '16/10'};`}
                >
                  {memory.mediaType === 'video' ? (
                    <div class="video-container">
                      <video
                        preload="metadata"
                        muted
                        playsinline
                        webkit-playsinline
                        loop
                        class="featured-memory-card__media"
                      >
                        <source src={mediaUrl} type="video/mp4" />
                      </video>
                      <div class="video-play-badge" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                          <path d="M8 5v14l11-7z" />
                        </svg>
                      </div>
                    </div>
                  ) : (
                    <img
                      src={mediaUrl}
                      alt={memory.title}
                      loading="lazy"
                      decoding="async"
                      class="featured-memory-card__media"
                    />
                  )}

                  {/* Overlaid Badges */}
                  <div class="featured-memory-card__overlay">
                    <span class="gen-pill">{genName}</span>
                    {memory.memoryYear && <span class="year-pill">{memory.memoryYear}</span>}
                  </div>
                </div>
              </a>

              <div class="featured-memory-card__content">
                <h3 class="featured-memory-card__title">
                  <a href={`/memories/${memory.id}`}>{memory.title}</a>
                </h3>
                <p class="featured-memory-card__story">{memory.story}</p>

                <footer class="featured-memory-card__footer">
                  <div class="featured-memory-card__author">
                    {authorPhoto ? (
                      <img
                        src={authorPhoto}
                        alt={authorName}
                        class="author-avatar"
                        loading="lazy"
                      />
                    ) : (
                      <div class="author-avatar author-avatar--fallback" aria-hidden="true">
                        {authorName.slice(0, 1).toUpperCase()}
                      </div>
                    )}
                    <span class="author-name">{authorName}</span>
                  </div>

                  <div class="featured-memory-card__meta">
                    {memory.reactionCount > 0 && (
                      <span class="meta-item" title="Reaksi">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                        </svg>
                        <span>{memory.reactionCount}</span>
                      </span>
                    )}
                    {memory.commentCount > 0 && (
                      <span class="meta-item" title="Komentar">
                        <svg
                          viewBox="0 0 24 24"
                          width="12"
                          height="12"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                        </svg>
                        <span>{memory.commentCount}</span>
                      </span>
                    )}
                  </div>
                </footer>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  )
}

<style>
  .featured-memories {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    max-width: var(--content-max);
    margin-inline: auto;
    padding: clamp(4rem, 9vw, 8rem) var(--page-gutter);
    overflow-x: clip;
  }

  .featured-memories__header {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .featured-memories__header {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .featured-memories__heading {
    display: grid;
    gap: 0.75rem;
    max-width: 44rem;
  }

  .featured-memories__tag {
    margin: 0;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 22ch;
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 4.25rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 0.98;
    color: var(--ink);
  }

  .featured-memories__intro {
    width: 100%;
    max-width: 38rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.1rem;
    line-height: 1.55;
  }

  .featured-memories__link {
    width: fit-content;
    min-height: 44px;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition:
      color 150ms ease,
      transform 150ms ease;
    white-space: nowrap;
  }

  .featured-memories__link:hover {
    color: var(--accent);
    transform: translateX(2px);
  }

  /* Grid Layout */
  .featured-memories__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .featured-memories__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .featured-memories__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
    }
  }

  /* Card Item */
  .featured-memory-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: 1rem;
    overflow: hidden;
    transition:
      transform 200ms var(--ease-out),
      border-color 200ms ease;
  }

  .featured-memory-card:hover {
    transform: translateY(-3px);
    border-color: var(--ink);
  }

  .featured-memory-card__media-link {
    display: block;
    text-decoration: none;
    overflow: hidden;
    background: var(--surface-muted);
  }

  .featured-memory-card__media-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--ink);
  }

  .featured-memory-card__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 350ms var(--ease-out);
  }

  .featured-memory-card:hover .featured-memory-card__media {
    transform: scale(1.03);
  }

  .video-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .video-container video {
    pointer-events: none;
  }

  .video-play-badge {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    background: rgba(18, 21, 20, 0.25);
    transition: background 150ms ease;
  }

  .video-play-badge svg {
    padding: 0.55rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(18, 21, 20, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.4);
    transition:
      transform 150ms ease,
      background 150ms ease;
  }

  .featured-memory-card:hover .video-play-badge svg {
    transform: scale(1.08);
    background: var(--accent);
  }

  .featured-memory-card__overlay {
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    right: 0.65rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    pointer-events: none;
  }

  .gen-pill {
    display: inline-flex;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    background: rgba(18, 21, 20, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .year-pill {
    display: inline-flex;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: var(--ink);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .featured-memory-card__content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.15rem;
    gap: 0.65rem;
  }

  .featured-memory-card__title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .featured-memory-card__title a {
    color: var(--ink);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .featured-memory-card__title a:hover {
    color: var(--accent);
  }

  .featured-memory-card__story {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-memory-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line-soft);
    margin-top: auto;
  }

  .featured-memory-card__author {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
  }

  .author-avatar {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .author-avatar--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-muted);
    border: 1px solid var(--line-soft);
    color: var(--ink-soft);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .author-name {
    font-size: 0.8rem;
    font-weight: 650;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .featured-memory-card__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ink-soft);
  }
</style>
