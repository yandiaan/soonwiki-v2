---
import { getGenerationName } from '@/lib/shared/generations';
import type { MemoryCard } from '@/lib/shared/memory-models';
import { paths, publicStorageUrl } from '@/lib/shared/paths';

interface Props {
  memories: MemoryCard[];
}

const { memories } = Astro.props;
const displayMemories = memories.slice(0, 4);
---

{
  displayMemories.length > 0 && (
    <section class="featured-memories" aria-labelledby="featured-memories-title" data-reveal>
      <div class="featured-memories__container">
        {/* Editorial Section Header */}
        <header class="featured-memories__header">
          <div class="featured-memories__meta">
            <div class="featured-memories__badge">
              <svg
                viewBox="0 0 24 24"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                <circle cx="8.5" cy="8.5" r="1.5" />
                <polyline points="21 15 16 10 5 21" />
              </svg>
              <span>Arsip Kenangan Komunitas</span>
            </div>
            <h2 id="featured-memories-title" class="featured-memories__title">
              Momen & Nostalgia Bersama SoonMates
            </h2>
            <p class="featured-memories__lead">
              Koleksi foto dan rekaman video kenangan yang diabadikan oleh alumni lintas generasi.
              Menghidupkan kembali jejak langkah, tawa, dan perjuangan bersama.
            </p>
          </div>
          <div class="featured-memories__actions">
            <a href={paths.memories()} class="explore-all-btn">
              <span>Buka Galeri Kenangan</span>
              <svg
                viewBox="0 0 16 16"
                width="14"
                height="14"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 8h10M9 4l4 4-4 4" />
              </svg>
            </a>
          </div>
        </header>

        {/* Grid of Memory Cards */}
        <div class="featured-memories__grid">
          {displayMemories.map((memory) => {
            const mediaUrl = publicStorageUrl('memories', memory.mediaPath);
            const authorPhoto = memory.author?.photoPath
              ? publicStorageUrl('profile-photos', memory.author.photoPath)
              : null;
            const authorName = memory.author?.name || 'SoonMate';
            const genName = getGenerationName(memory.generationKey);

            return (
              <article class="memory-card">
                <a
                  href={`/memories/${memory.id}`}
                  class="memory-card__media-link"
                  aria-label={`Buka detail kenangan: ${memory.title}`}
                >
                  <div
                    class="memory-card__media-wrap"
                    style={`aspect-ratio: ${memory.mediaAspectRatio || '16/10'};`}
                  >
                    {memory.mediaType === 'video' ? (
                      <div class="video-preview-box">
                        <video
                          src={mediaUrl}
                          preload="metadata"
                          muted
                          playsinline
                          class="memory-card__media"
                        />
                        <div class="video-play-indicator" aria-hidden="true">
                          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                            <path d="M8 5v14l11-7z" />
                          </svg>
                        </div>
                      </div>
                    ) : (
                      <img
                        src={mediaUrl}
                        alt={memory.title}
                        loading="lazy"
                        decoding="async"
                        class="memory-card__media"
                      />
                    )}

                    {/* Top Pill Overlay: Gen & Year */}
                    <div class="memory-card__tags">
                      <span class="gen-tag">{genName}</span>
                      {memory.memoryYear && <span class="year-tag">{memory.memoryYear}</span>}
                    </div>
                  </div>
                </a>

                {/* Card Content Details */}
                <div class="memory-card__body">
                  <h3 class="memory-card__title">
                    <a href={`/memories/${memory.id}`}>{memory.title}</a>
                  </h3>
                  <p class="memory-card__story">{memory.story}</p>

                  {/* Card Footer: Author + Counters */}
                  <footer class="memory-card__footer">
                    <div class="memory-card__author">
                      {authorPhoto ? (
                        <img
                          src={authorPhoto}
                          alt={authorName}
                          class="author-avatar"
                          loading="lazy"
                        />
                      ) : (
                        <div class="author-avatar author-avatar--placeholder" aria-hidden="true">
                          {authorName.slice(0, 1).toUpperCase()}
                        </div>
                      )}
                      <span class="author-name">{authorName}</span>
                    </div>

                    <div class="memory-card__metrics">
                      {memory.reactionCount > 0 && (
                        <span class="metric" title="Reaksi">
                          <svg
                            viewBox="0 0 24 24"
                            width="13"
                            height="13"
                            fill="currentColor"
                            stroke="none"
                          >
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                          </svg>
                          <span>{memory.reactionCount}</span>
                        </span>
                      )}
                      {memory.commentCount > 0 && (
                        <span class="metric" title="Komentar">
                          <svg
                            viewBox="0 0 24 24"
                            width="13"
                            height="13"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                          >
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                          </svg>
                          <span>{memory.commentCount}</span>
                        </span>
                      )}
                    </div>
                  </footer>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )
}

<style>
  .featured-memories {
    position: relative;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: clamp(3.5rem, 8vw, 6.5rem) var(--page-gutter);
  }

  .featured-memories__container {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .featured-memories__header {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .featured-memories__header {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .featured-memories__meta {
    display: grid;
    gap: 0.75rem;
    max-width: 44rem;
  }

  .featured-memories__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    width: fit-content;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--accent) 10%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 750;
    letter-spacing: 0.02em;
  }

  .featured-memories__title {
    margin: 0;
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--ink);
  }

  .featured-memories__lead {
    margin: 0;
    font-size: clamp(0.98rem, 1.8vw, 1.12rem);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .explore-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.75rem 1.35rem;
    border-radius: 9999px;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 750;
    text-decoration: none;
    box-shadow: 0 2px 8px -2px rgb(0 0 0 / 0.05);
    transition:
      transform 200ms var(--ease-out),
      background-color 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms var(--ease-out);
    white-space: nowrap;
  }

  .explore-all-btn:hover {
    transform: translateY(-2px);
    background: var(--ink);
    border-color: var(--ink);
    color: var(--surface);
    box-shadow: 0 10px 24px -4px rgb(0 0 0 / 0.12);
  }

  /* Memories Grid */
  .featured-memories__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .featured-memories__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .featured-memories__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  /* Memory Card Component */
  .memory-card {
    display: flex;
    flex-direction: column;
    border-radius: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    overflow: hidden;
    box-shadow: 0 4px 16px -4px rgb(0 0 0 / 0.04);
    transition:
      transform 280ms var(--ease-out),
      box-shadow 280ms var(--ease-out),
      border-color 200ms ease;
  }

  .memory-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 30%, var(--line-soft));
    box-shadow: 0 16px 36px -8px rgb(0 0 0 / 0.09);
  }

  .memory-card__media-link {
    display: block;
    text-decoration: none;
    overflow: hidden;
    background: var(--surface-muted);
  }

  .memory-card__media-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #000;
  }

  .memory-card__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms var(--ease-out);
  }

  .memory-card:hover .memory-card__media {
    transform: scale(1.04);
  }

  .video-preview-box {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .video-play-indicator {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(2px);
    transition: background-color 200ms ease;
  }

  .video-play-indicator svg {
    padding: 0.65rem;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.65);
    border: 1.5px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    transition: transform 200ms var(--ease-out);
  }

  .memory-card:hover .video-play-indicator svg {
    transform: scale(1.1);
    background: var(--accent);
    border-color: var(--surface);
  }

  .memory-card__tags {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    pointer-events: none;
  }

  .gen-tag {
    display: inline-flex;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    background: rgba(18, 21, 20, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.02em;
  }

  .year-tag {
    display: inline-flex;
    padding: 0.25rem 0.55rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .memory-card__body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    padding: 1.25rem;
    gap: 0.85rem;
  }

  .memory-card__title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .memory-card__title a {
    color: var(--ink);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .memory-card__title a:hover {
    color: var(--accent);
  }

  .memory-card__story {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .memory-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line-soft);
    margin-top: auto;
  }

  .memory-card__author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .author-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .author-avatar--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-muted);
    border: 1px solid var(--line-soft);
    color: var(--ink-soft);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .author-name {
    font-size: 0.82rem;
    font-weight: 650;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .memory-card__metrics {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .metric {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    font-weight: 750;
    color: var(--ink-soft);
  }
</style>
