---
import PortraitFrame from '@/components/astro/PortraitFrame.astro';
import StoryRail from '@/components/svelte/StoryRail.svelte';
import { getGenerationName } from '@/lib/shared/generations';
import { paths } from '@/lib/shared/paths';

import type { ProfileCard } from '@/lib/shared/public-models';

interface Props {
  profiles: ProfileCard[];
}

const { profiles } = Astro.props;
---

{
  profiles.length > 0 && (
    <section class="contact-sheet" aria-labelledby="contact-sheet-title" data-reveal>
      <header class="contact-sheet__header">
        <h2 id="contact-sheet-title">Lembar Kemungkinan</h2>
        <p>
          Sekilas fragmen perjalanan, karya, dan pilihan hidup SoonMates dari berbagai angkatan.
        </p>
      </header>
      <StoryRail client:idle count={profiles.length}>
        <ul class="contact-sheet__strip">
          {profiles.map((profile, index) => (
            <li class={`contact-sheet__item--variant-${index % 3}`}>
              <a href={paths.profile(profile.slug)}>
                <PortraitFrame
                  photoPath={profile.photoPath}
                  name={profile.name}
                  transitionKey={`profile-${profile.id}`}
                />
                <span class="contact-sheet__person">
                  <strong>{profile.name}</strong>
                  <span>
                    {profile.fieldLabels[0] ?? profile.currentActivity ?? 'Perjalanan'}
                    {`, ${getGenerationName(profile.batchYear)}`}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </StoryRail>
    </section>
  )
}

<style>
  .contact-sheet {
    display: grid;
    min-width: 0;
    gap: clamp(2rem, 5vw, 4rem);
    max-width: var(--content-max);
    margin-inline: auto;
    padding: clamp(4rem, 9vw, 8rem) var(--page-gutter);
  }

  .contact-sheet__heading {
    display: grid;
    min-width: 0;
    gap: 1rem;
  }

  h2 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 4.75rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .contact-sheet__heading p {
    width: 100%;
    max-width: 34rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .contact-sheet__heading > a {
    width: fit-content;
    min-height: 44px;
    color: var(--accent);
    font-weight: 750;
  }

  .contact-sheet__rail {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-sheet__rail li {
    flex: 0 0 auto;
    width: min(68vw, 18rem);
    scroll-snap-align: start;
  }

  .contact-sheet__rail li.contact-sheet__item--variant-1 {
    width: min(76vw, 22rem);
  }

  .contact-sheet__rail li.contact-sheet__item--variant-2 {
    width: min(60vw, 16rem);
  }

  .contact-sheet__rail a {
    display: grid;
    gap: 0.85rem;
    text-decoration: none;
  }

  .contact-sheet__rail :global(.portrait-frame) {
    border: 0;
    border-radius: 0.75rem;
  }

  .contact-sheet__person {
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
  }

  .contact-sheet__person > span {
    color: var(--ink-soft);
  }

  @media (min-width: 900px) {
    .contact-sheet__heading {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .contact-sheet__heading h2,
    .contact-sheet__heading p {
      grid-column: 1;
    }

    .contact-sheet__heading > a {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: start;
    }
  }
</style>
