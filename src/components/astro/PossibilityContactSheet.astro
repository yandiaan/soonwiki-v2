---
import PortraitFrame from '@/components/astro/PortraitFrame.astro';
import StoryRail from '@/components/svelte/StoryRail.svelte';
import { getGenerationName } from '@/lib/shared/generations';
import { paths } from '@/lib/shared/paths';

import type { ProfileCard } from '@/lib/shared/public-models';

interface Props {
  profiles: ProfileCard[];
}

const { profiles } = Astro.props;
---

{
  profiles.length > 0 && (
    <section class="contact-sheet" aria-labelledby="contact-sheet-title" data-reveal>
      <header class="contact-sheet__header">
        <p class="contact-sheet__tag">Lembar Kemungkinan</p>
        <h2 id="contact-sheet-title">Ragam jejak dan pilihan hidup SoonMates.</h2>
        <p class="contact-sheet__intro">
          Sekilas fragmen perjalanan, karya, dan pilihan hidup SoonMates dari berbagai angkatan.
        </p>
      </header>

      <StoryRail client:idle count={profiles.length}>
        <ul class="contact-sheet__strip">
          {profiles.map((profile, index) => (
            <li class={`contact-sheet__item contact-sheet__item--variant-${index % 3}`}>
              <a href={paths.profile(profile.slug)} class="contact-sheet__card">
                <div class="contact-sheet__frame">
                  <PortraitFrame
                    photoPath={profile.photoPath}
                    name={profile.name}
                    transitionKey={`profile-${profile.id}`}
                  />
                </div>
                <div class="contact-sheet__person">
                  <strong class="person-name">{profile.name}</strong>
                  <span class="person-meta">
                    {profile.fieldLabels[0] ?? profile.currentActivity ?? 'Perjalanan'}
                    {` · ${getGenerationName(profile.batchYear)}`}
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </StoryRail>
    </section>
  )
}

<style>
  .contact-sheet {
    display: grid;
    min-width: 0;
    gap: clamp(2rem, 5vw, 3.5rem);
    max-width: var(--content-max);
    margin-inline: auto;
    padding: clamp(4rem, 9vw, 8rem) var(--page-gutter);
  }

  .contact-sheet__header {
    display: grid;
    min-width: 0;
    gap: 0.75rem;
  }

  .contact-sheet__tag {
    margin: 0;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-sheet__header h2 {
    max-width: 22ch;
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 850;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--ink);
  }

  .contact-sheet__intro {
    width: 100%;
    max-width: 36rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .contact-sheet__strip {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0.5rem 0 1rem;
    list-style: none;
  }

  .contact-sheet__item {
    flex: 0 0 auto;
    width: min(68vw, 17.5rem);
    scroll-snap-align: start;
  }

  .contact-sheet__item--variant-1 {
    width: min(76vw, 20.5rem);
  }

  .contact-sheet__item--variant-2 {
    width: min(62vw, 15.5rem);
  }

  .contact-sheet__card {
    display: grid;
    gap: 0.85rem;
    text-decoration: none;
    color: inherit;
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-sheet__card:hover {
    transform: translateY(-4px);
  }

  .contact-sheet__frame {
    border-radius: 0.85rem;
    overflow: hidden;
    background: var(--surface-muted);
    box-shadow:
      0 4px 16px -4px rgba(18, 21, 20, 0.08),
      0 2px 6px -2px rgba(18, 21, 20, 0.04);
    transition:
      box-shadow 220ms ease,
      transform 220ms ease;
  }

  .contact-sheet__card:hover .contact-sheet__frame {
    box-shadow:
      0 16px 32px -8px rgba(18, 21, 20, 0.18),
      0 4px 12px -2px rgba(18, 21, 20, 0.08);
  }

  .contact-sheet__frame :global(.portrait-frame) {
    border: 0;
    border-radius: 0;
    aspect-ratio: 4 / 5;
  }

  .contact-sheet__person {
    display: grid;
    gap: 0.25rem;
    padding-inline: 0.2rem;
  }

  .person-name {
    font-size: 1rem;
    font-weight: 750;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.3;
    transition: color 150ms ease;
  }

  .contact-sheet__card:hover .person-name {
    color: var(--accent);
  }

  .person-meta {
    font-size: 0.84rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }
</style>
