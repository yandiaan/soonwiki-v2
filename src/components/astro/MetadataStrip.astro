---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <ul class="metadata-strip">
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  )
}

<style>
  .metadata-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
  }

  .metadata-strip li {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: var(--surface-muted);
    color: var(--ink-soft);
    font-weight: 600;
  }
</style>
