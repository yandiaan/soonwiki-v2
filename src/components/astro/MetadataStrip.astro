---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <ul class="metadata-strip">
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  )
}

<style>
  .metadata-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8rem;
    color: var(--ink);
  }

  .metadata-strip li:not(:last-child)::after {
    margin-inline-start: 1rem;
    color: var(--signal);
    content: '·';
  }
</style>
