---
import JoinWithGoogle from '@/components/svelte/JoinWithGoogle.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { describeAuthError } from '@/lib/shared/auth-errors';
import { paths } from '@/lib/shared/paths';

const { token } = Astro.params;

if (!token) {
  return Astro.redirect('/join-required');
}

const functionsUrl = `${import.meta.env.PUBLIC_SUPABASE_URL}/functions/v1/invitations`;
const validation = await fetch(functionsUrl, {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json',
    apikey: import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY,
  },
  body: JSON.stringify({ action: 'start', token }),
});

const invalidMessage = validation.ok
  ? null
  : describeAuthError(
      ((await validation.json().catch(() => null)) as { error?: string } | null)?.error,
    );
---

<BaseLayout
  title="Gabung ke SoonWiki"
  description="Gabung SoonWiki lewat tautan undangan resmi SOON."
>
  <main id="main-content" class="auth-page">
    <div class="auth-card" data-reveal>
      <header class="auth-card__header">
        <a href={paths.home()} class="auth-card__back" aria-label="Kembali ke Beranda">
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          <span>Beranda</span>
        </a>
        <span class="auth-card__tag">Undangan Valid</span>
        <h1>Mulai Ceritamu di SoonWiki</h1>
        <p class="auth-card__subtitle">
          {
            invalidMessage
              ? 'Tautan undangan ini tidak dapat digunakan.'
              : 'Tautan undangan terverifikasi. Sambungkan akun Google kamu untuk mengklaim profil keanggotaan Soonies.'
          }
        </p>
      </header>

      {
        invalidMessage ? (
          <div class="auth-card__alert" role="alert">
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="8" x2="12" y2="12" />
              <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            <span>{invalidMessage}</span>
          </div>
        ) : (
          <div class="auth-card__form">
            <JoinWithGoogle client:load mode="join" invitationToken={token} />
          </div>
        )
      }

      <footer class="auth-card__footer">
        <ul class="auth-card__perks">
          <li class="perk-item">
            <svg
              class="perk-icon"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Tulis babak kehidupan sejak lulus SOON</span>
          </li>
          <li class="perk-item">
            <svg
              class="perk-icon"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Katalogkan karya dan foto kebanggaanmu</span>
          </li>
        </ul>
      </footer>
    </div>
  </main>
</BaseLayout>

<style>
  .auth-page {
    position: relative;
    display: flex;
    min-height: calc(100svh - 4.5rem);
    align-items: center;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4.5rem) var(--page-gutter);
    background:
      radial-gradient(
        ellipse at 50% 10%,
        color-mix(in srgb, var(--accent) 12%, transparent),
        transparent 60%
      ),
      var(--canvas);
  }

  .auth-card {
    position: relative;
    display: grid;
    gap: 1.75rem;
    width: min(100%, 30rem);
    padding: clamp(2rem, 5vw, 3rem);
    border-radius: 1.25rem;
    border: 1px solid var(--line-soft);
    background: var(--surface);
    box-shadow:
      0 24px 60px -12px rgb(0 0 0 / 0.08),
      0 4px 16px -2px rgb(0 0 0 / 0.03);
  }

  .auth-card__header {
    display: grid;
    gap: 0.75rem;
  }

  .auth-card__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    margin-bottom: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      color 150ms ease,
      transform 150ms ease;
  }

  .auth-card__back:hover {
    color: var(--ink);
    transform: translateX(-2px);
  }

  .auth-card__tag {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.85rem, 4vw, 2.35rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .auth-card__subtitle {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .auth-card__alert {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--signal) 30%, transparent);
    background: color-mix(in srgb, var(--signal) 8%, var(--surface));
    color: var(--signal);
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .auth-card__alert svg {
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .auth-card__form {
    padding-block: 0.25rem;
  }

  .auth-card__footer {
    display: grid;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-soft);
  }

  .auth-card__perks {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .perk-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink-soft);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .perk-icon {
    flex-shrink: 0;
    color: var(--accent);
  }
</style>
