---
import EmptyState from '@/components/astro/EmptyState.astro';
import ProfileCard from '@/components/astro/ProfileCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getBatchCollection } from '@/lib/server/public-repository';
import { getGenerationName, SOON_GENERATIONS } from '@/lib/shared/generations';
import { paths, publicStorageUrl } from '@/lib/shared/paths';
import '@/styles/collections.css';

const generationKey = Astro.params.key ?? '';
const generation = SOON_GENERATIONS.find((item) => item.key === generationKey);

if (!generation) {
  return new Response('Angkatan ini tidak ditemukan.', { status: 404 });
}

const result = await getBatchCollection(Astro, generationKey);

if (!result.ok) {
  return new Response('Angkatan ini tidak ditemukan.', { status: 404 });
}

const { profiles } = result.data;
const generationName = getGenerationName(generationKey);
const coverPhoto = profiles[0]?.photoPath
  ? publicStorageUrl('profile-photos', profiles[0].photoPath)
  : undefined;
---

<BaseLayout
  title={`${generationName} | SoonWiki`}
  description={`Kisah dan perjalanan hidup SoonMates dari angkatan ${generationName}.`}
  canonical={new URL(`/batch/${generationKey}`, Astro.url)}
  image={coverPhoto}
>
  <main id="main-content" class="collection">
    <header class="collection__header">
      <p class="collection__tag">Generasi SOON</p>
      <h1>{generationName}</h1>
      <p class="collection__intro">
        Perjalanan dan jejak langkah SoonMates dari {generationName}, dari berbagai jalan hidup.
      </p>
    </header>
    {
      profiles.length === 0 ? (
        <EmptyState
          title="Belum ada kisah di sini"
          description="Belum ada SoonMates dari angkatan ini yang menerbitkan profilnya."
          actionHref={paths.explore()}
          actionLabel="Jelajahi semua"
        />
      ) : (
        <ul class="collection__grid">
          {profiles.map((profile) => (
            <li>
              <ProfileCard profile={profile} />
            </li>
          ))}
        </ul>
      )
    }
  </main>
</BaseLayout>
