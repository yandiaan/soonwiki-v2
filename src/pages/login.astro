---
import JoinWithGoogle from '@/components/svelte/JoinWithGoogle.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getMemberSession } from '@/lib/server/session';
import { paths } from '@/lib/shared/paths';

const session = await getMemberSession(Astro);
if (session?.member?.status === 'active') {
  if (session.member.role === 'admin') {
    return Astro.redirect(paths.admin());
  }
  return Astro.redirect(paths.me());
}

const message = Astro.url.searchParams.get('message');
---

<BaseLayout
  title="Masuk ke SoonWiki"
  description="Masuk ke SoonWiki untuk mengelola perjalanan dan kisah kamu."
>
  <main id="main-content" class="login-layout">
    <!-- Left Column: Editorial Showcase (Seamless Dark Surface) -->
    <aside class="login-showcase" aria-hidden="true">
      <div class="login-showcase__ambient">
        <div class="showcase-orb showcase-orb--1"></div>
        <div class="showcase-orb showcase-orb--2"></div>
      </div>

      <div class="login-showcase__content" data-reveal>
        <blockquote class="showcase-quote">
          <p>
            “Banyak cara untuk menjalani hidup. Setiap pilihan dan titik balik SoonMates layak
            dicatat dan dibagikan.”
          </p>
        </blockquote>

        <div class="showcase-footer">
          <div class="showcase-avatars">
            <img
              src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=120&q=80"
              alt=""
              class="avatar"
            />
            <img
              src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&q=80"
              alt=""
              class="avatar"
            />
            <img
              src="https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=120&q=80"
              alt=""
              class="avatar"
            />
            <span class="avatar-count">+6</span>
          </div>
          <div class="showcase-meta">
            <strong>Komunitas Terkurasi</strong>
            <span>Menghubungkan lintas angkatan dan bidang</span>
          </div>
        </div>
      </div>
    </aside>

    <!-- Right Column: Direct-on-Surface Minimalist Form -->
    <section class="login-panel" aria-labelledby="login-title">
      <header class="login-panel__top">
        <a href={paths.home()} class="login-back-btn">
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          <span>Kembali ke Beranda</span>
        </a>
      </header>

      <div class="login-panel__center">
        <div class="login-surface-form" data-reveal>
          <div class="login-header">
            <span class="login-tag">Ruang Khusus SoonMates</span>
            <h1 id="login-title">Masuk ke SoonWiki</h1>
            <p class="login-subtitle">
              Sambungkan akun Google terdaftarmu untuk memperbarui linimasa perjalanan dan karya
              kebanggaanmu.
            </p>
          </div>

          {
            message && (
              <div class="login-alert" role="alert">
                <svg
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="10" />
                  <line x1="12" y1="8" x2="12" y2="12" />
                  <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
                <span>{message}</span>
              </div>
            )
          }

          <div class="login-action">
            <JoinWithGoogle client:load mode="login" />
          </div>

          <div class="login-perks">
            <div class="login-perk">
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Sunting babak hidup sejak lulus SOON</span>
            </div>
            <div class="login-perk">
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Katalogkan karya dan momen kebanggaan</span>
            </div>
            <div class="login-perk">
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Terhubung dalam direktori terpercaya alumni</span>
            </div>
          </div>

          <footer class="login-footer">
            <p class="invite-notice">
              Belum punya akses? SoonWiki adalah arsip terkurasi. Hubungi koordinator angkatan SOON
              untuk mendapatkan tautan undangan.
            </p>
          </footer>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .login-layout {
    display: grid;
    min-height: calc(100svh - 4.5rem);
    background: var(--surface);
  }

  /* Left Showcase Panel (Seamless Dark Editorial Surface) */
  .login-showcase {
    position: relative;
    display: none;
    overflow: hidden;
    background: var(--ink);
    color: var(--surface);
    padding: clamp(3.5rem, 7vw, 6rem);
  }

  .login-showcase__ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .showcase-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.38;
    mix-blend-mode: screen;
  }

  .showcase-orb--1 {
    top: -10%;
    left: -10%;
    width: 34rem;
    height: 34rem;
    background: radial-gradient(circle, var(--accent) 0%, transparent 70%);
  }

  .showcase-orb--2 {
    bottom: -15%;
    right: -10%;
    width: 38rem;
    height: 38rem;
    background: radial-gradient(circle, #2a4365 0%, transparent 70%);
  }

  .login-showcase__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    max-width: 34rem;
  }

  .showcase-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.95rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--surface) 10%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid color-mix(in srgb, var(--surface) 16%, transparent);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    width: fit-content;
  }

  .showcase-badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .showcase-quote {
    margin: 4.5rem 0;
    padding: 0;
  }

  .showcase-quote p {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 550;
    line-height: 1.25;
    letter-spacing: -0.03em;
    color: var(--surface);
  }

  .showcase-footer {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--surface) 14%, transparent);
  }

  .showcase-avatars {
    display: flex;
    align-items: center;
  }

  .showcase-avatars .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    object-fit: cover;
    margin-left: -8px;
  }

  .showcase-avatars .avatar:first-child {
    margin-left: 0;
  }

  .showcase-avatars .avatar-count {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: color-mix(in srgb, var(--surface) 18%, transparent);
    font-size: 0.75rem;
    font-weight: 750;
    margin-left: -8px;
  }

  .showcase-meta strong {
    display: block;
    font-size: 0.92rem;
    color: var(--surface);
  }

  .showcase-meta span {
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--surface) 65%, transparent);
  }

  /* Right Direct-on-Surface Panel */
  .login-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(2rem, 5vw, 4.5rem);
    background: var(--surface);
  }

  .login-panel__top {
    display: flex;
    align-items: center;
  }

  .login-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      color 150ms ease,
      transform 150ms ease;
  }

  .login-back-btn:hover {
    color: var(--ink);
    transform: translateX(-3px);
  }

  .login-panel__center {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding-block: 3rem;
  }

  /* Direct on surface - no card container box */
  .login-surface-form {
    display: grid;
    gap: 2rem;
    width: min(100%, 26rem);
  }

  .login-header {
    display: grid;
    gap: 0.75rem;
  }

  .login-tag {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.1rem, 4vw, 2.65rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .login-subtitle {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .login-alert {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--signal) 30%, transparent);
    background: color-mix(in srgb, var(--signal) 8%, var(--surface));
    color: var(--signal);
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .login-alert svg {
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .login-action {
    padding-top: 0.25rem;
  }

  .login-perks {
    display: grid;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-soft);
  }

  .login-perk {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink-soft);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .login-perk svg {
    flex-shrink: 0;
    color: var(--accent);
  }

  .login-footer {
    padding-top: 0.75rem;
  }

  .invite-notice {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  @media (min-width: 960px) {
    .login-layout {
      grid-template-columns: 1.15fr 1fr;
    }

    .login-showcase {
      display: block;
    }
  }
</style>
