---
import EmptyState from '@/components/astro/EmptyState.astro';
import ProfileCard from '@/components/astro/ProfileCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getFieldCollection } from '@/lib/server/public-repository';
import { paths } from '@/lib/shared/paths';
import '@/styles/collections.css';

const { slug } = Astro.params;

if (!slug) {
  return new Response('Hal yang ditekuni ini tidak ditemukan.', { status: 404 });
}

const result = await getFieldCollection(Astro, slug);

if (!result.ok) {
  return new Response('Hal yang ditekuni ini tidak ditemukan.', { status: 404 });
}

const { name, profiles } = result.data;
---

<BaseLayout
  title={name}
  description={`Soonies yang menekuni ${name}.`}
  canonical={new URL(`/field/${slug}`, Astro.url)}
>
  <main id="main-content" class="collection">
    <header class="collection__header">
      <p class="collection__tag">Hal yang ditekuni</p>
      <h1>{name}</h1>
      <p class="collection__intro">
        Soonies yang menekuni {name} di berbagai peran, tempat, dan tahap perjalanan.
      </p>
    </header>
    {
      profiles.length === 0 ? (
        <EmptyState
          title="Belum ada kisah di sini"
          description="Belum ada Soonies yang menekuni bidang ini dan menerbitkan profilnya."
          actionHref={paths.explore()}
          actionLabel="Jelajahi semua Soonies"
        />
      ) : (
        <ul class="collection__grid">
          {profiles.map((profile) => (
            <li>
              <ProfileCard profile={profile} />
            </li>
          ))}
        </ul>
      )
    }
  </main>
</BaseLayout>
