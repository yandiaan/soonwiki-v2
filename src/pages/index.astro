---
import EmptyState from '@/components/astro/EmptyState.astro';
import ExplorePathways from '@/components/astro/ExplorePathways.astro';
import FeaturedJourney from '@/components/astro/FeaturedJourney.astro';
import PossibilityContactSheet from '@/components/astro/PossibilityContactSheet.astro';
import ProudMomentFrame from '@/components/astro/ProudMomentFrame.astro';
import StoryChapter from '@/components/astro/StoryChapter.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getHomeStoryData } from '@/lib/server/public-repository';
import { paths } from '@/lib/shared/paths';
import '@/styles/home.css';

const result = await getHomeStoryData(Astro);

const chapters = result.ok
  ? [
      { label: 'Sejak SOON', story: result.data.featured.sinceSoonStory, frameNumber: '002' },
      { label: 'Turning point', story: result.data.featured.turningPointStory, frameNumber: '003' },
      {
        label: 'Arah sekarang',
        story: result.data.featured.currentDirectionStory,
        frameNumber: '004',
      },
    ].filter((chapter): chapter is typeof chapter & { story: string } => Boolean(chapter.story))
  : [];

const firstProudMoment = result.ok ? result.data.featured.proudMoments[0] : undefined;
---

<BaseLayout
  title="SoonWiki"
  description="Arsip hidup perjalanan member dan alumni SOON."
  canonical={new URL('/', Astro.url)}
>
  <main id="main-content" class="home">
    {
      result.ok ? (
        <>
          <FeaturedJourney profile={result.data.featured} />
          {chapters.length > 0 && (
            <div class="home__chapters">
              {chapters.map((chapter) => (
                <StoryChapter
                  label={chapter.label}
                  story={chapter.story}
                  frameNumber={chapter.frameNumber}
                />
              ))}
            </div>
          )}
          {firstProudMoment && <ProudMomentFrame moment={firstProudMoment} />}
          <PossibilityContactSheet profiles={result.data.contactSheet} />
          <ExplorePathways story={result.data} />
        </>
      ) : (
        <EmptyState
          title="Belum ada kisah yang terbit"
          description="SoonWiki baru saja dimulai. Begitu member pertama menerbitkan profilnya, kisah mereka akan tampil di sini."
          actionHref={paths.login()}
          actionLabel="Masuk sebagai member"
        />
      )
    }
  </main>
</BaseLayout>
