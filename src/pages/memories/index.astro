---
import MemoryGalleryGrid from '@/components/svelte/MemoryGalleryGrid.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { listMemories } from '@/lib/server/memory-repository';
import { createServerSupabase } from '@/lib/supabase/server';

const supabase = createServerSupabase(Astro);
const {
  data: { user },
} = await supabase.auth.getUser();

const result = await listMemories(supabase);
const memories = result.ok && result.data ? result.data : [];
---

<BaseLayout
  title="Galeri Kenangan & Momen Berharga · SoonWiki"
  description="Ruang nostalgia dan album kenangan bersama keluarga besar SOON lintas angkatan. Telusuri foto, video, dan kisah tak terlupakan."
  canonical={new URL('/memories', Astro.url)}
>
  <main id="main-content" class="memories-page">
    <!-- Editorial Hero -->
    <header class="memories-hero" data-hero-glass>
      <div class="memories-hero__badge">
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
        <span>Album Momen Komunitas</span>
      </div>
      <h1 class="memories-hero__title">Galeri Kenangan</h1>
      <p class="memories-hero__lead">
        Menghidupkan kembali kisah, tawa, perjuangan, dan momen berharga yang terajut sepanjang
        perjalanan SOON lintas generasi.
      </p>
    </header>

    <!-- Interactive Grid Island -->
    <div class="memories-gallery-container">
      <MemoryGalleryGrid client:load initialMemories={memories} isAuthenticated={Boolean(user)} />
    </div>
  </main>
</BaseLayout>

<style>
  .memories-page {
    max-width: 76rem;
    margin-inline: auto;
    padding-inline: var(--page-gutter);
    padding-block: 2rem 6rem;
  }

  .memories-hero {
    display: grid;
    gap: 0.75rem;
    padding-block-end: 2.5rem;
    max-width: 48rem;
  }

  .memories-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .memories-hero__title {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    color: var(--ink);
    line-height: 1;
  }

  .memories-hero__lead {
    margin: 0.35rem 0 0;
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .memories-gallery-container {
    padding-top: 1rem;
  }
</style>
