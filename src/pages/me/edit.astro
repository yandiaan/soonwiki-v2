---
import ProfileEditor from '@/components/svelte/ProfileEditor.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { listAllFields, loadOwnProfile } from '@/lib/server/member-repository';
import { getMemberSession } from '@/lib/server/session';
import { createServerSupabase } from '@/lib/supabase/server';
import '@/styles/editor.css';

const session = await getMemberSession(Astro);

if (!session) {
  return Astro.redirect('/login');
}

if (!session.member || session.member.status !== 'active') {
  return Astro.redirect('/join-required');
}

const supabase = createServerSupabase(Astro);
const [profileResult, availableFields] = await Promise.all([
  loadOwnProfile(supabase),
  listAllFields(supabase),
]);

if (!profileResult.ok) {
  return new Response('Terjadi kesalahan saat memuat profil.', { status: 500 });
}

const bundle = profileResult.data;
const isWelcome = Astro.url.searchParams.get('welcome') === '1';
---

<BaseLayout
  title="Studio Profil | SoonWiki"
  description="Kelola dan perbarui profil perjalanan hidup SoonWiki kamu."
>
  <main id="main-content" class="editor-page">
    <header class="editor-header">
      {
        isWelcome ? (
          <div class="welcome-badge">
            <span class="badge-sparkle" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="14"
                height="14"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3z" />
              </svg>
            </span>
            <span>Selamat Datang di SoonWiki!</span>
          </div>
        ) : (
          <span class="editor-eyebrow">Studio Profil SoonMates</span>
        )
      }
      <h1 class="editor-title">
        {bundle?.profile ? 'Perbarui Jejak & Karyamu' : 'Mulai Cerita Perjalananmu'}
      </h1>
      <p class="editor-lead">
        Ruang personal untuk mengabadikan babak hidup, refleksi, karya, dan jejak langkahmu. Kamu
        bisa mengisi secara bertahap dan menyimpannya kapan saja.
      </p>
    </header>

    <ProfileEditor
      client:load
      userId={session.user.id}
      initialProfile={bundle?.profile ?? null}
      initialJourneys={bundle?.journeys ?? []}
      initialFieldIds={bundle?.fieldIds ?? []}
      initialProudMoments={bundle?.proudMoments ?? []}
      availableFields={availableFields}
    />
  </main>
</BaseLayout>

<style>
  .editor-page {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .editor-header {
    display: grid;
    gap: 0.6rem;
    padding-block: 1rem 2rem;
    max-width: 44rem;
  }

  .welcome-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: #fef3c7;
    color: #92400e;
    font-size: 0.82rem;
    font-weight: 750;
    width: fit-content;
  }

  .editor-eyebrow {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .editor-title {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3.25rem);
    font-weight: 750;
    letter-spacing: -0.035em;
    line-height: 1.06;
    color: var(--ink);
  }

  .editor-lead {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.55;
  }
</style>
