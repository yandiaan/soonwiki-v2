---
import JourneyChapterList from '@/components/astro/JourneyChapterList.astro';
import ProfileHero from '@/components/astro/ProfileHero.astro';
import ProudMomentGallery from '@/components/astro/ProudMomentGallery.astro';
import RelatedJourneys from '@/components/astro/RelatedJourneys.astro';
import StoryChapter from '@/components/astro/StoryChapter.astro';
import ReportDialog from '@/components/svelte/ReportDialog.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProfileBySlug } from '@/lib/server/public-repository';
import { publicStorageUrl } from '@/lib/shared/paths';
import '@/styles/profile.css';

const { slug } = Astro.params;

if (!slug) {
  return new Response('Profil tidak ditemukan.', { status: 404 });
}

const result = await getProfileBySlug(Astro, slug);

if (!result.ok) {
  return new Response('Profil tidak ditemukan.', { status: 404 });
}

const profile = result.data;

const socialLinks = [
  profile.linkedinUrl && { href: profile.linkedinUrl, label: 'LinkedIn', type: 'linkedin' },
  profile.instagramUrl && { href: profile.instagramUrl, label: 'Instagram', type: 'instagram' },
  profile.websiteUrl && { href: profile.websiteUrl, label: 'Situs Pribadi', type: 'website' },
].filter(
  (link): link is { href: string; label: string; type: 'linkedin' | 'instagram' | 'website' } =>
    Boolean(link),
);

const image = profile.photoPath ? publicStorageUrl('profile-photos', profile.photoPath) : undefined;
---

<BaseLayout
  title={`${profile.name} · SoonWiki`}
  description={profile.bio ?? `Jejak langkah dan kisah perjalanan ${profile.name} di SoonWiki.`}
  canonical={new URL(`/people/${profile.slug}`, Astro.url)}
  {...image ? { image } : {}}
>
  <main id="main-content" class="profile">
    <!-- Main Profile Hero Section -->
    <ProfileHero profile={profile} />

    <!-- Chapter 1: Sejak SOON -->
    {
      profile.sinceSoonStory && (
        <StoryChapter label="Sejak SOON" story={profile.sinceSoonStory} frameNumber="01" />
      )
    }

    <!-- Chapter 2: Rekam Linimasa Perjalanan -->
    {profile.journeys.length > 0 && <JourneyChapterList journeys={profile.journeys} />}

    <!-- Chapter 3: Titik Balik (Turning Point) -->
    {
      profile.turningPointStory && (
        <StoryChapter
          label="Titik Balik (Turning Point)"
          story={profile.turningPointStory}
          frameNumber="02"
          variant="pullquote"
        />
      )
    }

    <!-- Chapter 4: Proud Moments Showcase -->
    {profile.proudMoments.length > 0 && <ProudMomentGallery moments={profile.proudMoments} />}

    <!-- Chapter 5: Arah Sekarang & Masa Depan -->
    {
      profile.currentDirectionStory && (
        <StoryChapter
          label="Arah Sekarang"
          story={profile.currentDirectionStory}
          frameNumber="03"
        />
      )
    }

    <!-- Connect & Collaborate Callout -->
    {
      socialLinks.length > 0 && (
        <section class="profile__connect-card" data-reveal aria-label="Jalin Koneksi">
          <div class="profile__connect-header">
            <span class="profile__connect-tag">
              <svg
                viewBox="0 0 24 24"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
              </svg>
              <span>Jalin Koneksi</span>
            </span>
            <h2 class="profile__connect-title">Tertarik Bertukar Pikiran dengan {profile.name}?</h2>
            <p class="profile__connect-desc">
              Buka ruang dialog, inisiatif kolaborasi karya, atau sekadar menyapa melalui tautan
              resmi berikut.
            </p>
          </div>

          <div class="profile__connect-actions">
            {socialLinks.map((link, idx) => (
              <a
                href={link.href}
                target="_blank"
                rel="noreferrer"
                class={`connect-link ${idx === 0 ? 'connect-link--primary' : ''}`}
                aria-label={`Hubungi melalui ${link.label}`}
              >
                {link.type === 'linkedin' && (
                  <svg
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                    <rect x="2" y="9" width="4" height="12" />
                    <circle cx="4" cy="4" r="2" />
                  </svg>
                )}
                {link.type === 'instagram' && (
                  <svg
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                  </svg>
                )}
                {link.type === 'website' && (
                  <svg
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <line x1="2" y1="12" x2="22" y2="12" />
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                  </svg>
                )}
                <span>Kunjungi {link.label}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- Related SoonMates Profiles -->
    {profile.relatedProfiles.length > 0 && <RelatedJourneys profiles={profile.relatedProfiles} />}

    <!-- Report / Feedback footer -->
    <div class="profile__report" data-reveal>
      <ReportDialog client:visible profileId={profile.id} />
    </div>
  </main>
</BaseLayout>
