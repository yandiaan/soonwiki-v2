---
import '@fontsource-variable/plus-jakarta-sans';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: URL;
}

const { title, description, image, canonical } = Astro.props;
const siteName = 'SoonWiki';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1ebdd" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    {canonical && <link rel="canonical" href={canonical.toString()} />}
    <title>{fullTitle}</title>
  </head>
  <body>
    <!--
    THESIS: SoonWiki is a living editorial contact sheet that opens possible lives after SOON, refusing the generic search-first corporate directory.
    OWN-WORLD: Warm newsprint, near-black ink, committed cobalt fields, signal orange metadata, documentary portraits, numbered frames, hard rules, and Plus Jakarta Sans.
    STORY: A visitor meets one honest alumni journey, follows its turning point and proud moments, then discovers many other valid paths through the SOON community.
    FIRST VIEWPORT: One documentary portrait and one decisive turning-point line lead; search remains a secondary Explore action rather than the hero.
    FORM: Lembar Kontak Redaksi, approved reference .impeccable/mocks/homepage-contact-sheet-b.png; story-first composition is locked before Task 7.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <a class="skip-link" href="#main-content">Lewati ke konten utama</a>
    <slot />
  </body>
</html>
