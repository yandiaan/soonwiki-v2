---
interface Props {
  code: string;
  title: string;
  description: string;
  actionHref?: string;
  actionLabel?: string;
}

const { code, title, description, actionHref, actionLabel } = Astro.props;
---

<main id="main-content" class="error-state">
  <p class="error-state__code">{code}</p>
  <h1>{title}</h1>
  <p>{description}</p>
  {actionHref && actionLabel && <a href={actionHref}>{actionLabel}</a>}
</main>

<style>
  .error-state {
    display: grid;
    min-height: 70vh;
    max-width: 32rem;
    gap: 0.75rem;
    align-content: center;
    padding: var(--page-gutter);
  }

  .error-state__code {
    margin: 0;
    color: var(--signal);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3rem);
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    color: var(--cobalt);
  }

  a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
</style>
