---
import EmptyState from '@/components/astro/EmptyState.astro';
import ExplorePathways from '@/components/astro/ExplorePathways.astro';
import FeaturedJourney from '@/components/astro/FeaturedJourney.astro';
import PossibilityContactSheet from '@/components/astro/PossibilityContactSheet.astro';
import ProudMomentFrame from '@/components/astro/ProudMomentFrame.astro';
import PublicHero from '@/components/astro/PublicHero.astro';
import PublicIntroduction from '@/components/astro/PublicIntroduction.astro';
import TurningPointMosaic from '@/components/astro/TurningPointMosaic.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getHomeStoryData } from '@/lib/server/public-repository';
import { paths, publicStorageUrl } from '@/lib/shared/paths';
import '@/styles/home.css';

const result = await getHomeStoryData(Astro);

const firstProudMoment = result.ok ? result.data.proudMoment : undefined;
const featuredPhoto =
  result.ok && result.data.featured.photoPath
    ? publicStorageUrl('profile-photos', result.data.featured.photoPath)
    : undefined;
---

<BaseLayout
  title="SoonWiki"
  description="Arsip hidup perjalanan member dan alumni SOON. Temukan kisah, titik balik, dan karya kebanggaan SoonMates."
  canonical={new URL('/', Astro.url)}
  image={featuredPhoto}
>
  <main id="main-content" class="home">
    <PublicHero
      featured={result.ok ? result.data.featured : undefined}
      profiles={result.ok ? result.data.contactSheet : []}
      stats={result.ok ? result.data.stats : undefined}
    />
    <PublicIntroduction
      featured={result.ok ? result.data.featured : undefined}
      profiles={result.ok ? result.data.contactSheet : []}
    />
    {
      result.ok ? (
        <>
          <FeaturedJourney profile={result.data.featured} />
          {result.data.turningPoints.length > 0 && (
            <TurningPointMosaic highlights={result.data.turningPoints} />
          )}
          <PossibilityContactSheet profiles={result.data.contactSheet} />
          {firstProudMoment && (
            <ProudMomentFrame
              moment={firstProudMoment}
              profileSlug={result.data.featured.slug}
              profileName={result.data.featured.name}
            />
          )}
          <ExplorePathways story={result.data} />
        </>
      ) : (
        <EmptyState
          title="Belum ada kisah yang terbit"
          description="SoonWiki baru saja dimulai. Begitu member pertama menerbitkan profilnya, kisah mereka akan tampil di sini."
          actionHref={paths.login()}
          actionLabel="Masuk sebagai member"
        />
      )
    }
  </main>
</BaseLayout>
