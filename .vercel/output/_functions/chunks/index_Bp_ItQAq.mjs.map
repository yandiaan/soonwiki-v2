---
import PortraitFrame from '@/components/astro/PortraitFrame.astro';
import { paths } from '@/lib/shared/paths';

import type { ProfileCard, ProfileDetail } from '@/lib/shared/public-models';

interface Props {
  featured?: ProfileDetail | undefined;
  profiles?: ProfileCard[];
}

const { featured, profiles = [] } = Astro.props;
const people = [
  ...(featured
    ? [
        {
          id: featured.id,
          name: featured.name,
          photoPath: featured.photoPath,
        },
      ]
    : []),
  ...profiles,
].slice(0, 3);
---

<section id="tentang" class="public-intro" aria-labelledby="public-intro-title">
  <div class="public-intro__copy">
    <h2 id="public-intro-title">Arsip hidup, bukan direktori pekerjaan.</h2>
    <p>
      SoonWiki menyimpan perubahan, pilihan, karya, dan hal-hal yang berarti bagi komunitas SOON.
    </p>
    <a href={paths.explore()}>Kenali SoonWiki</a>
  </div>
  {
    people.length > 0 && (
      <ul class="public-intro__portraits">
        {people.map((person) => (
          <li>
            <PortraitFrame photoPath={person.photoPath} name={person.name} />
          </li>
        ))}
        <li class="public-intro__accent" aria-hidden="true" />
      </ul>
    )
  }
</section>

<style>
  .public-intro {
    display: grid;
    min-height: min(52rem, 90svh);
    max-width: var(--content-max);
    margin-inline: auto;
    padding: clamp(4rem, 9vw, 8rem) var(--page-gutter);
  }

  .public-intro__copy {
    display: grid;
    align-content: start;
    gap: 1.5rem;
  }

  h2 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.7rem, 6vw, 5.8rem);
    font-weight: 550;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .public-intro__copy p {
    max-width: 38rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.1rem;
    line-height: 1.55;
  }

  .public-intro__copy a {
    width: fit-content;
    min-height: 44px;
    color: var(--ink);
    font-weight: 700;
  }

  .public-intro__portraits {
    display: grid;
    min-width: 0;
    grid-template-columns: 1.1fr 0.35fr 1fr;
    grid-template-rows: repeat(2, minmax(10rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .public-intro__portraits li:first-child {
    grid-row: 1 / 3;
  }

  .public-intro__portraits li:nth-child(2) {
    grid-column: 3;
  }

  .public-intro__portraits li:nth-child(3) {
    grid-column: 3;
  }

  .public-intro__portraits :global(.portrait-frame) {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0.75rem;
    aspect-ratio: auto;
  }

  .public-intro__accent {
    grid-column: 2;
    grid-row: 1 / 3;
    border-radius: 0.75rem;
    background: var(--accent);
  }

  @media (min-width: 900px) {
    .public-intro {
      grid-template-columns: minmax(0, 0.9fr) minmax(30rem, 1.1fr);
      align-items: center;
      gap: clamp(3rem, 7vw, 8rem);
    }
  }

  @media (max-width: 899px) {
    .public-intro {
      min-height: auto;
      gap: 3rem;
    }

    .public-intro__portraits {
      min-height: 32rem;
    }
  }
</style>
