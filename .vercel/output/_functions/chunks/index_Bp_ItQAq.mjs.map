---
import PortraitFrame from '@/components/astro/PortraitFrame.astro';
import { paths } from '@/lib/shared/paths';

import type { ProfileDetail } from '@/lib/shared/public-models';

interface Props {
  profile: ProfileDetail;
}

const { profile } = Astro.props;
const source = profile.turningPointStory ?? profile.sinceSoonStory ?? profile.currentDirectionStory;

function toLead(value: string | null, fallback: string) {
  if (!value) return fallback;

  const firstSentence = value.match(/^.*?[.!?](?:\s|$)/)?.[0]?.trim() ?? value.trim();
  if (firstSentence.length <= 170) return firstSentence;

  const shortened = firstSentence.slice(0, 167);
  return `${shortened.slice(0, shortened.lastIndexOf(' '))}…`;
}

const lead = toLead(source, `Perjalanan ${profile.name} dari SOON.`);
const metadata = [
  `Soon ${profile.batchYear}`,
  profile.fieldLabels[0],
  profile.currentPlaceName,
].filter((item): item is string => Boolean(item));
---

<section class="featured-journey" aria-labelledby="featured-journey-title" data-reveal>
  <div class="featured-journey__media">
    <PortraitFrame
      photoPath={profile.photoPath}
      name={profile.name}
      loading="lazy"
      transitionKey={`profile-${profile.id}`}
    />
  </div>
  <div class="featured-journey__story">
    <p class="featured-journey__tag">Kisah Sorotan</p>
    <h2 id="featured-journey-title">{profile.name}</h2>
    <ul class="featured-journey__metadata">
      {metadata.map((item) => <li>{item}</li>)}
    </ul>
    <p class="featured-journey__lead">{lead}</p>
    {
      profile.currentDirectionStory && (
        <p class="featured-journey__direction">{profile.currentDirectionStory}</p>
      )
    }
    <a href={paths.profile(profile.slug)}>Baca perjalanan {profile.name} →</a>
  </div>
</section>

<style>
  .featured-journey {
    display: grid;
    max-width: var(--content-max);
    min-height: min(54rem, 90svh);
    margin: clamp(2rem, 6vw, 6rem) auto;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--ink);
    color: var(--surface);
  }

  .featured-journey__media {
    min-height: 28rem;
  }

  .featured-journey__media :global(.portrait-frame) {
    width: 100%;
    height: 100%;
    border: 0;
    aspect-ratio: auto;
    background: #879087;
  }

  .featured-journey__story {
    display: grid;
    align-content: center;
    gap: 1.25rem;
    padding: clamp(2rem, 5vw, 5rem);
  }

  .featured-journey__tag {
    margin: 0;
    color: var(--accent-soft);
    font-size: 0.85rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: clamp(2.6rem, 5vw, 5rem);
    font-weight: 550;
    line-height: 0.96;
    letter-spacing: -0.04em;
  }

  .featured-journey__metadata {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0;
    padding: 0;
    color: color-mix(in srgb, var(--surface) 64%, transparent);
    list-style: none;
    font-size: 0.9rem;
  }

  .featured-journey__lead {
    max-width: 32ch;
    margin: 1rem 0 0;
    font-size: clamp(1.55rem, 3vw, 2.5rem);
    line-height: 1.24;
    letter-spacing: -0.025em;
  }

  .featured-journey__direction {
    max-width: 36rem;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--surface) 22%, transparent);
    color: color-mix(in srgb, var(--surface) 76%, transparent);
    line-height: 1.55;
  }

  .featured-journey__story a {
    display: inline-flex;
    width: fit-content;
    min-height: 48px;
    align-items: center;
    padding-inline: 1.2rem;
    border-radius: 0.75rem;
    background: var(--accent);
    color: var(--surface);
    font-weight: 750;
    text-decoration: none;
  }

  .featured-journey__story a:hover {
    background: var(--accent-strong);
    transform: translateY(-2px);
  }

  @media (min-width: 900px) {
    .featured-journey {
      width: calc(100% - 2 * var(--page-gutter));
      grid-template-columns: minmax(0, 1.7fr) minmax(28rem, 1fr);
    }
  }

  @media (max-width: 899px) {
    .featured-journey {
      margin-inline: var(--page-gutter);
    }
  }
</style>
