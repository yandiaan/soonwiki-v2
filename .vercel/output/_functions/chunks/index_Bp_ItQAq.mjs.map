---
import { paths, publicStorageUrl } from '@/lib/shared/paths';

import type { ProudMoment } from '@/lib/shared/public-models';

interface Props {
  moment: ProudMoment;
  profileSlug?: string;
  profileName?: string;
}

const { moment, profileSlug, profileName } = Astro.props;
const imageUrl = moment.imagePath ? publicStorageUrl('proud-moments', moment.imagePath) : null;
const captionParts = [moment.placeName, moment.year ? String(moment.year) : null].filter(
  (part): part is string => Boolean(part),
);
---

<section class="proud-moment" aria-labelledby="proud-moment-title" data-reveal>
  <div class="proud-moment__frame">
    {
      imageUrl && (
        <img
          class="proud-moment__image"
          src={imageUrl}
          alt={moment.title}
          loading="lazy"
          decoding="async"
        />
      )
    }
    <div class="proud-moment__overlay">
      <p class="proud-moment__context">Hal yang berarti bagi {profileName ?? 'seorang Soonie'}</p>
      <h2 id="proud-moment-title">{moment.title}</h2>
      {moment.description && <p class="proud-moment__description">{moment.description}</p>}
      {captionParts.length > 0 && <p class="proud-moment__caption">{captionParts.join(' · ')}</p>}
      <div class="proud-moment__actions">
        {
          moment.externalUrl && (
            <a href={moment.externalUrl} target="_blank" rel="noreferrer">
              Lihat selengkapnya
            </a>
          )
        }
        {
          profileSlug && profileName && (
            <a href={paths.profile(profileSlug)}>Baca perjalanan {profileName}</a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .proud-moment {
    max-width: var(--content-max);
    margin-inline: auto;
    padding: clamp(4rem, 9vw, 8rem) var(--page-gutter);
  }

  .proud-moment__frame {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--ink);
    color: var(--surface);
  }

  .proud-moment__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .proud-moment__overlay {
    display: grid;
    align-content: end;
    gap: 1rem;
    min-height: min(36rem, 76svh);
    padding: clamp(2rem, 5vw, 5rem);
  }

  .proud-moment__frame:has(.proud-moment__image) .proud-moment__overlay {
    position: relative;
    min-height: min(50rem, 86svh);
    background:
      linear-gradient(90deg, rgb(10 12 11 / 0.9) 0%, rgb(10 12 11 / 0.58) 44%, transparent 78%),
      linear-gradient(0deg, rgb(10 12 11 / 0.45), transparent 62%);
  }

  h2 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .proud-moment__context {
    margin: 0;
    color: color-mix(in srgb, var(--surface) 70%, transparent);
    font-size: 0.9rem;
    font-weight: 650;
  }

  .proud-moment__description {
    max-width: 60ch;
    margin: 0;
  }

  .proud-moment__caption {
    margin: 0;
    color: color-mix(in srgb, var(--surface) 72%, transparent);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .proud-moment__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .proud-moment__actions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    color: var(--surface);
    text-decoration-color: color-mix(in srgb, var(--surface) 45%, transparent);
  }
</style>
