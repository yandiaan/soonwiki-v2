---
interface Props {
  label: string;
  story: string;
  frameNumber?: string;
  variant?: 'default' | 'pullquote';
}

const { label, story, frameNumber, variant = 'default' } = Astro.props;
---

<article class={`story-chapter story-chapter--${variant}`} data-story-chapter>
  {frameNumber && <p class="frame-number">{frameNumber}</p>}
  <p class="label">{label}</p>
  {
    variant === 'pullquote' ? (
      <blockquote class="story-chapter__quote">
        <span class="story-chapter__mark" aria-hidden="true">
          “
        </span>
        {story}
      </blockquote>
    ) : (
      <p class="story">{story}</p>
    )
  }
</article>

<style>
  .story-chapter {
    display: grid;
    gap: 0.75rem;
    padding-block: 2rem;
    border-top: 1px solid var(--line-soft);
  }

  .story-chapter--pullquote {
    padding-block: 2.5rem;
  }

  .frame-number {
    margin: 0;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.04em;
  }

  .label {
    margin: 0;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 750;
  }

  .story {
    margin: 0;
    max-width: 54ch;
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--ink);
  }

  .story-chapter__quote {
    max-width: 44rem;
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .story-chapter__mark {
    display: block;
    margin-block-end: -0.2em;
    color: var(--accent);
    font-size: clamp(3rem, 8vw, 4.5rem);
    line-height: 1;
  }
</style>
