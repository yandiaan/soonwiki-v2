---
interface Props {
  title: string;
  description: string;
  actionHref?: string;
  actionLabel?: string;
}

const { title, description, actionHref, actionLabel } = Astro.props;
---

<div class="empty-state">
  <h2>{title}</h2>
  <p>{description}</p>
  {actionHref && actionLabel && <a href={actionHref}>{actionLabel}</a>}
</div>

<style>
  .empty-state {
    display: grid;
    max-width: 32rem;
    gap: 0.75rem;
    padding: var(--page-gutter);
  }

  .empty-state a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-weight: 700;
    color: var(--cobalt);
  }
</style>
