---
import PortraitFrame from '@/components/astro/PortraitFrame.astro';
import { paths } from '@/lib/shared/paths';

import type { ProfileCard as ProfileCardModel } from '@/lib/shared/public-models';

interface Props {
  profile: ProfileCardModel;
}

const { profile } = Astro.props;
const subtitle = [
  profile.fieldLabels[0] ?? profile.currentActivity,
  profile.currentPlaceName,
  `Soon ${profile.batchYear}`,
].filter((item): item is string => Boolean(item));
---

<a class="profile-card" href={paths.profile(profile.slug)}>
  <div class="profile-card__media">
    <PortraitFrame
      photoPath={profile.photoPath}
      name={profile.name}
      transitionKey={`profile-${profile.id}`}
    />
  </div>
  <div class="profile-card__info">
    <strong>{profile.name}</strong>
    {subtitle.length > 0 && <span>{subtitle.join(' · ')}</span>}
  </div>
</a>

<style>
  .profile-card {
    display: grid;
    gap: 0.75rem;
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 300ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .profile-card:hover {
    transform: translateY(-3px);
  }

  .profile-card:hover strong {
    color: var(--accent);
  }

  .profile-card__media {
    overflow: hidden;
    border-radius: 0.75rem;
  }

  .profile-card__info {
    display: grid;
    gap: 0.25rem;
  }

  .profile-card__info strong {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .profile-card__info span {
    color: var(--ink-soft);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .profile-card:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 0.75rem;
  }
</style>
