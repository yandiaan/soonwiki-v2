---
import EmptyState from '@/components/astro/EmptyState.astro';
import ProfileCard from '@/components/astro/ProfileCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPlaceCollection } from '@/lib/server/public-repository';
import { paths, publicStorageUrl } from '@/lib/shared/paths';
import '@/styles/collections.css';

const { slug } = Astro.params;

if (!slug) {
  return new Response('Tempat ini tidak ditemukan.', { status: 404 });
}

const result = await getPlaceCollection(Astro, slug);

if (!result.ok) {
  return new Response('Tempat ini tidak ditemukan.', { status: 404 });
}

const { name, profiles } = result.data;
const coverPhoto = profiles[0]?.photoPath
  ? publicStorageUrl('profile-photos', profiles[0].photoPath)
  : undefined;
---

<BaseLayout
  title={name}
  description={`SoonMates yang menjalani proses dan perjalanannya di ${name}.`}
  canonical={new URL(`/place/${slug}`, Astro.url)}
  image={coverPhoto}
>
  <main id="main-content" class="collection">
    <header class="collection__header">
      <p class="collection__tag">Tempat, organisasi, atau usaha</p>
      <h1>{name}</h1>
      <p class="collection__intro">SoonMates yang menjalani perjalanannya lewat {name}.</p>
    </header>
    {
      profiles.length === 0 ? (
        <EmptyState
          title="Belum ada kisah di sini"
          description="Belum ada SoonMates di tempat ini yang menerbitkan profilnya."
          actionHref={paths.explore()}
          actionLabel="Jelajahi semua"
        />
      ) : (
        <ul class="collection__grid">
          {profiles.map((profile) => (
            <li>
              <ProfileCard profile={profile} />
            </li>
          ))}
        </ul>
      )
    }
  </main>
</BaseLayout>
