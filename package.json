{
  "name": "soonwiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node ./dist/server/entry.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "db:push": "supabase db push --linked",
    "db:lint": "supabase db lint --linked --level warning",
    "db:types": "supabase gen types typescript --linked > src/types/database.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "astro": "^7.2.9",
    "lenis": "^1.3.26",
    "motion": "^13.1.1",
    "svelte": "^5.57.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "supabase": "^2.116.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
